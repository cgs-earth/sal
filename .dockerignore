# Ignore any local rdf data artifacts when building the sal cli
**/*.nq.gz
.sal/data/**
*.md
Dockerfile
.dockerignore
.git
**/node_modules
.env
examples/**
# The demo image re-includes the one example project file it copies in.
!examples/usage/portolan_export.ttl
docs/**
**/.astro
.claude/**

# Local build products that are never part of the image: the go build output
# at the repo root and the pyspark integration test's virtualenv.
sal
**/.venv
