@prefix portolan: <salmodule://github.com/cgs-earth/sal-portolan/> .

<https://example.org/my-project/tasks/geospatial-extract>
    a portolan:Extract ;
    portolan:sources (
        [
            portolan:provider "arcgis" ;
            portolan:url "https://services.arcgis.com/6fiE7QkLWSPMd0N5/ArcGIS/rest/services/boston/FeatureServer" ;
            portolan:options ( "--output-crs" "EPSG:4326"  "--license" "CC-BY-4.0" )
        ]
        [
            portolan:provider "arcgis" ;
            portolan:url "https://services.arcgis.com/6fiE7QkLWSPMd0N5/ArcGIS/rest/services/1_Neighborhoods_Philadelphia/FeatureServer" ;
            portolan:options ( "--output-crs" "EPSG:4326"  "--license" "CC-BY-4.0" )
        ]
        [
            portolan:provider "arcgis" ;
            portolan:url "https://services.arcgis.com/6fiE7QkLWSPMd0N5/ArcGIS/rest/services/PIttsburgh_incomes_22/FeatureServer" ;
            portolan:options ( "--output-crs" "EPSG:4326"  "--license" "CC-BY-4.0" )
        ]
    ) .