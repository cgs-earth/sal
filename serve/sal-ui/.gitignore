# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist-ssr
*.local

# dist/ is build output: `make ui` writes it and serve/ui.go embeds whatever it
# holds, so it is never committed. The .gitkeep is what keeps the embed
# directive compiling in a tree where the UI has not been built; the release
# workflow and the Dockerfile build the UI before building sal.
dist/*
!dist/.gitkeep

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
