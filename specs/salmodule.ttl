@prefix salmodule:  <https://w3id.org/sal/cgs-earth/sal/ontology/salmodule#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .


<https://w3id.org/sal/cgs-earth/sal/ontology/salmodule#> a owl:Ontology ;
                                                             dc:creator "Andrew Padilla" ;
                                                             dc:date "2024-06-01"^^xsd:date ;
                                                             dc:description "This is the SAL Module vocabulary for implementing the SAL Module specification in containerized application logic orchestrated within SAL projects"@en ;
                                                             dc:title "The Semantic Accessibility Layer (SAL) Module Ontology"@en ;
                                                             rdfs:label "SAL Module"@en ;
                                                             owl:versionInfo "0.0.1" ;
                                                             salmodule:protocolScheme "salmodule" .
                                                             

#################################################################
#    Ontology properties
#################################################################



###  https://w3id.org/sal/cgs-earth/sal/ontology/salmodule#protocolScheme
salmodule:protocolScheme a owl:AnnotationProperty ;
                         rdfs:comment "The protocol scheme used to identify SAL Module resources."@en ;
                         rdfs:label "Protocol Scheme"@en ;
                         rdfs:seeAlso salmodule:OntologyCommand, salmodule:RunCommand ;
                         skos:example "salmodule://github.com/owner/repository" ;
                         skos:note """Dereferencing an ontology with a SAL Module protocol scheme involves using 1) the github based protocol 
    to clone the remote git repository 2) build the container image using the Dockerfile located in 
    the base repository directory and 3) run the container using the salmodule:OntologyCommand."""@en .

                    


#################################################################
#    Datatypes
#################################################################

#################################################################
#    Annotation Properties
#################################################################

###  https://w3id.org/sal/cgs-earth/sal/ontology/salmodule#stdinShape
salmodule:stdinShape a owl:AnnotationProperty ;
                rdfs:range sh:NodeShape ;
                rdfs:comment "An annotation property representing the required SHACL sh:NodeShape(s) of the newline delimited JSON node input stream from stdin to a salmodule:Task within a SAL Module containerized application."@en ;
                rdfs:label "JSON(-LD) Node stdin SHACL Shape"@en ;
                skos:note "It is the responsibility of the salmodule:Task subclass implementation to inject its ontology's JSON-LD @context into the JSON input node to resolve to its vocabulary."@en ,
                          "The input stream accepts newline delimited JSON objects (not JSON-LD)."@en .


###  https://w3id.org/sal/cgs-earth/sal/ontology/salmodule#stdoutShape
salmodule:stdoutShape a owl:AnnotationProperty ;
                 rdfs:range sh:NodeShape ;
                 rdfs:comment "An annotation property representing the required SHACL sh:NodeShape(s) of the newline delimited JSON node output stream to stdout from a salmodule:Task subclass instance within a SAL Module containerized application."@en ;
                 rdfs:label "JSON(-LD) Node stdout SHACL Shape"@en ;
                 skos:note "The output stream must produce newline delimited JSON nodes that conform to the specified sh:NodeShape(s) when injected with the JSON-LD @context object defined within the salmodule's ontology."@en .

###  https://w3id.org/sal/cgs-earth/sal/ontology/salmodule#stderrShape
salmodule:stderrShape a owl:AnnotationProperty ;
                 rdfs:range sh:NodeShape ;
                 rdfs:comment "An annotation property representing the required SHACL sh:NodeShape(s) of the newline delimited JSON node error stream to stderr from a salmodule:Task subclass instance within a SAL Module containerized application."@en ;
                 rdfs:label "JSON(-LD) Node stderr SHACL Shape"@en ;
                 skos:note "The error stream must produce newline delimited JSON nodes that conform to the specified sh:NodeShape(s) when injected with the JSON-LD @context object defined within the salmodule's ontology."@en .

###  https://w3id.org/sal/cgs-earth/sal/ontology/salmodule#taskShape
salmodule:taskShape a owl:AnnotationProperty ;
               rdfs:range sh:NodeShape ;
               rdfs:comment "An annotation property representing the required shape of the salmodule:Task subclass instance itself."@en ;
               rdfs:label "JSON(-LD) Node Task SHACL Shape"@en .


#################################################################
#    Classes
#################################################################
salmodule:Specification a owl:Class ;
                  rdfs:comment "A class representing the SAL Module specification."@en ;
                  rdfs:label "SAL Module Specification"@en ;
                  skos:note "The SAL Module Specification class is the base class of all classes and their individuals that describe the specification."@en .


###  https://w3id.org/sal/cgs-earth/sal/ontology/salmodule#Task
salmodule:Task a owl:Class ;
               rdfs:comment "A class representing an operational task within a SAL Module containerized application."@en ;
               rdfs:label "Task"@en ;
               rdfs:subClassOf salmodule:Specification ;
               skos:note "SAL Module implementers create subclasses of salmodule:Task to define specific operational tasks within the containerized application."@en ;
               rdfs:seeAlso salmodule:TaskInstance, salmodule:RunCommand;
               salmodule:stderrShape [ a sh:NodeShape ;
                                  sh:property [ sh:message "An rdfs:comment (message) is required for salmodule:Error instances"@en ;
                                                sh:minCount 1 ;
                                                sh:path rdfs:comment
                                              ] ,
                                              [ sh:message "An rdfs:label is required for salmodule:Error instances"@en ;
                                                sh:minCount 1 ;
                                                sh:path rdfs:label
                                              ] ;
                                  sh:targetClass salmodule:Error
                                ] .



###  https://w3id.org/sal/cgs-earth/sal/ontology/salmodule#Error
salmodule:Error a owl:Class ;
                rdfs:comment "A class representing an error condition within a salmodule:Task at runtime."@en ;
                rdfs:label "Error"@en ;
                rdfs:subClassOf salmodule:Specification ;
                rdfs:seeAlso salmodule:Task ,
                             salmodule:RunCommand ;
                skos:note "Instances of salmodule:Error represent error conditions that occur during the execution of a salmodule:Task within a SAL Module containerized application."@en .

###  https://w3id.org/sal/cgs-earth/sal/ontology/salmodule#Command
salmodule:Command a owl:Class;
                rdfs:label "Command"@en;
                rdfs:comment "A class representing a command that can be executed within a SAL Module containerized application as part of the SAL Module command line specification."@en;
                rdfs:subClassOf salmodule:Specification ;
                rdfs:seeAlso salmodule:Task .

salmodule:EnvironmentVariable a owl:Class ;
                rdfs:label "Environment Variable"@en ;
                rdfs:comment "A class representing an environment variable that is part of the SAL Module specification."@en ;
                rdfs:subClassOf salmodule:Specification .
              
#################################################################
# Properties
#################################################################

###  https://w3id.org/sal/cgs-earth/sal/ontology/salmodule#hasSubCommand
salmodule:hasSubCommand a owl:ObjectProperty ;
                rdfs:label "has subcommand"@en ;
                rdfs:comment "Relates a salmodule:Command instance to its subcommand(s) that can be executed by a SAL Module containerized application."@en ;
                rdfs:domain salmodule:Command ;
                rdfs:range salmodule:Command .

###  https://w3id.org/sal/cgs-earth/sal/ontology/salmodule#isSubCommandOf
salmodule:isSubCommandOf a owl:ObjectProperty ;
                rdfs:label "is subcommand of"@en ;
                rdfs:comment "Relates a salmodule:Command instance to its parent command instance that can be executed by a SAL Module containerized application."@en ;
                rdfs:domain salmodule:Command ;
                owl:inverseOf salmodule:hasSubCommand ;
                rdfs:range salmodule:Command .


#################################################################
#  Individuals (Instance Data) 
#################################################################

# The following individuals are used to represent the SAL Module command line specification for containerized applications that adhere to the SAL Module specification.

###  https://w3id.org/sal/cgs-earth/sal/ontology/salmodule#SALModuleCommand
salmodule:SALModuleCommand a salmodule:Command ;
                rdfs:label "salmodule"@en ;
                rdfs:comment "The base command for all containerized applications that adhere to the SAL Module specification."@en ;
                salmodule:hasSubCommand salmodule:RunCommand, salmodule:OntologyCommand .
              
###  https://w3id.org/sal/cgs-earth/sal/ontology/salmodule#RunCommand
salmodule:RunCommand a salmodule:Command ;
                rdfs:label "run"@en ;
                salmodule:isSubCommandOf salmodule:SALModuleCommand ;
                rdfs:comment "The command that invokes a salmodule:Task subclass instance within a SAL Module containerized application."@en ;
                rdfs:seeAlso  salmodule:TaskInstance .

###  https://w3id.org/sal/cgs-earth/sal/ontology/salmodule#OntologyCommand
salmodule:OntologyCommand a salmodule:Command ;
                rdfs:label "ontology"@en ,
                            "vocab"@en ,
                            "vocabulary"@en ;
                salmodule:isSubCommandOf salmodule:SALModuleCommand ;
                rdfs:comment "The command that prints the SAL Module ontology to stdout in JSON-LD format."@en .
           
salmodule:TaskInstance a salmodule:EnvironmentVariable ;
                rdfs:label "SALMODULE_TASK_INSTANCE"@en ;
                rdfs:comment "The environment variable that identifies the instance of a salmodule:Task subclass defined in a SAL Module ontology to be invoked by salmodule:RunCommand."@en ;
                rdfs:seeAlso salmodule:RunCommand .


#################################################################
#    OWL Axioms
#    
#    These classes are for reasoners. They are NOT meant to be 
#    used directly (subclassed). 
#    Please subclass salmodule:Task instead 
#################################################################

###  https://w3id.org/sal/cgs-earth/sal/ontology/salmodule#NodeConsumer
salmodule:NodeConsumer a owl:Class ;
                       owl:equivalentClass [ owl:intersectionOf ( salmodule:Task
                                                                  [ a owl:Restriction ;
                                                                    owl:onProperty salmodule:stdinShape ;
                                                                    owl:someValuesFrom sh:NodeShape
                                                                  ]
                                                                ) ;
                                             a owl:Class
                                           ] ;
                       rdfs:comment "An inferred class representing an entity that consumes JSON(-LD) newline delimited JSON node stream from stdin within a SAL Module containerized application. Do NOT use this class directly to subclass your task. Used salmodule:Task instead. Intended for OWL Reasoner."@en ;
                       rdfs:label "Node Consumer"@en .


###  https://w3id.org/sal/cgs-earth/sal/ontology/salmodule#NodeProcessor
salmodule:NodeProcessor a owl:Class ;
                        owl:equivalentClass [ owl:intersectionOf ( salmodule:Task
                                                                   [ a owl:Restriction ;
                                                                     owl:onProperty salmodule:stdinShape ;
                                                                     owl:someValuesFrom sh:NodeShape
                                                                   ]
                                                                   [ a owl:Restriction ;
                                                                     owl:onProperty salmodule:stdoutShape ;
                                                                     owl:someValuesFrom sh:NodeShape
                                                                   ]
                                                                 ) ;
                                              a owl:Class
                                            ] ;
                        rdfs:comment "An inferred class representing an entity that processes newline delimited JSON node streams via stdin/stdout within a SAL Module containerized application. Do NOT use this class directly to subclass your task. Used salmodule:Task instead. Intended for OWL Reasoner."@en ;
                        rdfs:label "Node Processor"@en .


###  https://w3id.org/sal/cgs-earth/sal/ontology/salmodule#NodeProducer
salmodule:NodeProducer a owl:Class ;
                       owl:equivalentClass [ owl:intersectionOf ( salmodule:Task
                                                                  [ a owl:Restriction ;
                                                                    owl:onProperty salmodule:stdoutShape ;
                                                                    owl:someValuesFrom sh:NodeShape
                                                                  ]
                                                                ) ;
                                             a owl:Class
                                           ] ;
                       rdfs:comment "An inferred class representing an entity that produces a newline delimited JSON node stream to stdout within a SAL Module containerized application. Do NOT use this class directly to subclass your task. Used salmodule:Task instead. Intended for OWL Reasoner."@en ;
                       rdfs:label "Node Producer"@en .

